{
    "type": "package",
    "name": "gampleman/elm-translate-icu",
    "summary": "Parse and format ICU MessageFormat messages in Elm",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [
        "Icu.Ast",
        "Icu.Parser",
        "Icu.Locale",
        "Icu.Value",
        "Icu.Format",
        "Icu.Bundle",
        "Icu.Codegen"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "anmolitor/intl-proxy": "1.0.0 <= v < 2.0.0",
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/json": "1.0.0 <= v < 2.0.0",
        "elm/parser": "1.1.0 <= v < 2.0.0",
        "elm/time": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
